# Operating mode — LIVE is gated and disabled by default
OPERATING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Optional: Jupiter quote/route only (default v2). Never used for broadcast.
JUPITER_API_BASE=https://api.jup.ag/swap/v2
JUPITER_API_KEY=

# Optional: Helius RPC / DAS
HELIUS_API_KEY=
HELIUS_RPC_URL=

# Optional: Birdeye-compatible market data
BIRDEYE_API_KEY=
BIRDEYE_API_BASE=https://public-api.birdeye.so

# Optional: OpenAI-compatible research LLM (mock used if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RESEARCH_MODEL=gpt-4o-mini

# Optional: Supabase / Postgres (in-memory demo used if unset)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo / paper defaults
DEMO_MODE=true
PAPER_STARTING_CAPITAL_USD=100000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_OPERATING_MODE=PAPER

# Bind — default loopback. Remote demo: SAT_BIND_HOST=0.0.0.0 plus SAT_API_TOKEN and SAT_ALLOWED_ORIGINS.
SAT_BIND_HOST=127.0.0.1
SAT_BIND_PORT=4317
SAT_ALLOWED_ORIGINS=
SAT_API_TOKEN=

# Public portfolio demo — anonymous users are read-only.
PUBLIC_DEMO=false
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=8

# Paper engine realism (set 0 for deterministic E2E)
PAPER_FAIL_PROBABILITY=0.03
PAPER_PARTIAL_PROBABILITY=0.12
